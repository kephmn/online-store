{
  "name": "app",
  "private": true,
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --format=esm --outdir=public --public-path=/ --loader:.js=jsx",
    "build:css": "sass ./app/assets/stylesheets/application.bootstrap.scss:./public/application.css --no-source-map --load-path=node_modules"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "autoprefixer": "^10.5.4",
    "axios": "^1.19.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sass": "^1.103.1"
  }
}
